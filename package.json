{
  "name": "chur",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "build": "nuxt build",
    "preview": "nuxt preview --dotenv .env.local",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "setup:token": "node --env-file-if-exists=.env.local scripts/database.ts token",
    "db:backup": "node --env-file-if-exists=.env.local scripts/database.ts backup",
    "db:restore": "node scripts/database.ts restore"
  },
  "dependencies": {
    "nuxt": "4.6.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7",
    "h3": "2.0.8",
    "nitropack": "2.13.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.14.0",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/tui-project/chur.git"
  },
  "bugs": {
    "url": "https://github.com/tui-project/chur/issues"
  }
}
